# Copy to `.env` for local development. Do not commit `.env`.
# Firebase: Firebase Console → Project settings → Your apps → Web app config

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional frontend overrides (AI is proxied via Cloud Functions; keys go in firebase-functions/.env)
VITE_OPENROUTER_MODEL=
VITE_OPENROUTER_IMAGE_MODEL=
VITE_GEMINI_IMAGE_MODEL=

# Cloudinary (file uploads)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Optional: YouTube integration
VITE_YOUTUBE_API_KEY=
